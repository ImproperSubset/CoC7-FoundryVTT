#!/usr/bin/env bash
# Prints each of the project's metrics as a diary paragraph, and its change
# since the last such paragraph in the diary: duplication always, and test
# coverage and the tests set aside where the project has a pytest or vitest
# hook, or a hook in the `pytest` or `vitest` group. In a fork, a project with
# an `upstream` remote, it adds the fork's own copies and the coverage of the
# lines it changed, both counted from where its branch last met upstream.
# /hh-wrap puts the paragraphs in its session summary and the changes in its
# report. Metrics are reported, never judged: this script fails only when it
# cannot measure.
#
# The paragraph is matched with its whitespace collapsed, because mdformat may
# wrap it across lines.
set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 1
cd "${root}" || exit 1

# jscpd through the project's own prek hook, at its pinned version and
# arguments. The `.:` selector runs the root project's hook only, not that of a
# nested prek project.
out="$(prek run .:jscpd --all-files 2>&1)"
total="$(grep -F 'Total:' <<<"${out}" | tail -1)"
if [[ -z "${total}" ]]; then
    printf 'hh-metrics: no jscpd total in the output of prek run .:jscpd:\n%s\n' "${out}" >&2
    exit 1
fi
# The total row's cells: files, lines, tokens, clones, duplicated lines.
IFS='│' read -r _ _ files lines _ clones dup _ <<<"${total}"
files="${files//[[:space:]]/}"
lines="${lines//[[:space:]]/}"
clones="${clones//[[:space:]]/}"
dup_lines="$(sed -E 's/^ *([0-9]+) .*/\1/' <<<"${dup}")"
dup_pct="$(sed -E 's/.*\(([0-9.]+)%\).*/\1/' <<<"${dup}")"
for v in "${files}" "${lines}" "${clones}" "${dup_lines}" "${dup_pct}"; do
    if [[ ! "${v}" =~ ^[0-9.]+$ ]]; then
        printf 'hh-metrics: could not read the jscpd total row: %s\n' "${total}" >&2
        exit 1
    fi
done

dup_now="Metrics: duplication ${clones} clones, ${dup_lines} of ${lines} lines (${dup_pct}%) in ${files} files."
dup_pattern='Metrics: duplication [0-9]+ clones, [0-9]+ of [0-9]+ lines \([0-9.]+%\) in [0-9]+ files\.'

# Prints the number a test runner's summary gives before the word, or 0 where
# the summary has no such count, as when no test was skipped.
count() {
    if [[ "$1" =~ (^|[^0-9])([0-9]+)\ $2([^a-z]|$) ]]; then
        echo "${BASH_REMATCH[2]}"
    else
        echo 0
    fi
}

# A runner's output with its colour codes taken out, since a project may have
# its runner print in colour, and the codes split the words read below (diary
# decision 2026-11-22: runners' colour codes stripped, not turned off).
plain() {
    sed -E $'s/\x1b\\[[0-9;]*[A-Za-z]//g'
}

# The tests set aside are counted in every hook of a runner's group, so a
# project's second test hook, such as one with a config of its own, is counted
# with the pack's. A project puts each such hook in the group, `pytest` or
# `vitest`, with prek's `groups` field, and the pack's own hook is read whether
# it is in the group or not. Coverage is read from the pack's hook alone: the
# diary's figures are of it, and a figure from another hook covers a different
# set of tests, which no text summary can be added to. Only the root project's
# hooks are read, as `.:` selects them. Each hook runs under `-v`, which prints
# the output of a hook that passes without `verbose = true` (diary decision
# 2026-11-24: v0.31.0's code for cases no client meets cut).
#
# `prek list --group` needs prek 0.4.5 or later, and is asked in every project;
# on an earlier prek the script fails with prek's own error.
#
# A hook left out of the commit checks, kept in `prek.toml` marked
# `stages = ["manual"]` until its findings are fixed, is passed over, and named
# in a `Not measured:` line: its figures would be those of tests that do not
# pass, and prek would still run it here, since it falls back to the manual
# stage for a hook named on its command line. The stages are read from prek's
# own listing, not from `prek.toml`, so a hook that sets none, or one under a
# `default_stages` that holds `pre-commit`, is measured (diary decision
# 2026-11-26: a test hook left out passed over by hh-metrics).
left_out=()

# Prints, for each hook of the group, `run <selector>` where prek runs it at
# commit, and `left <selector>` where it does not.
hooks_of() {
    local grouped all err errf rc
    errf="$(mktemp "${TMPDIR:-/tmp}/hh-metrics-err.XXXXXX")" || exit 1
    grouped="$(prek list --group "$1" --output-format json 2>"${errf}")"
    rc=$?
    err="$(<"${errf}")"
    if ((rc != 0)); then
        command rm -f -- "${errf:?}"
        printf 'hh-metrics: prek list --group %s failed; it needs prek 0.4.5 or later:\n%s\n' \
            "$1" "${err}" >&2
        exit 1
    fi
    all="$(prek list --output-format json 2>"${errf}")"
    rc=$?
    err="$(<"${errf}")"
    command rm -f -- "${errf:?}"
    if ((rc != 0)); then
        printf 'hh-metrics: prek list failed:\n%s\n' "${err}" >&2
        exit 1
    fi
    jq -r --arg runner "$1" --argjson grouped "${grouped}" '
        ([".:" + $runner] + [$grouped[].full_id]) as $wanted
        | map(select(.full_id | IN($wanted[]) and startswith(".:")))
        | unique_by(.full_id) | .[]
        | if (.stages | type) != "array" then error("no stages listed for " + .full_id)
          elif any(.stages[]; . == "pre-commit") then "run " + .full_id
          else "left " + .full_id end' \
        <<<"${all}" || {
        printf 'hh-metrics: could not read the hooks of the %s group\n' "$1" >&2
        exit 1
    }
}

# Runs each hook of a runner's group that the project has and hands its output
# to the runner's reader, `read_<runner>`, with the hook's selector; a hook that
# prints nothing the reader can read fails the script there. A hook of the group
# that prek skips because no file matches its `files`, for which prek prints a
# line of its own, not indented as a hook's output is, ending
# `(no files to check)Skipped`, ran no tests and adds nothing; the pack's own
# hook skipped fails the script, since its coverage figure would be missing
# (diary decision 2026-11-24: v0.31.0's code for cases no client meets cut).
# Sets `ran` where any hook ran. The pytest hooks alone get the option below, so a
# hook of the `vitest` group runs as its commit check does. pytest 9 counts a
# skipped or xfailed subtest in its summary line as skipped or xfailed only
# where its subtest verbosity is not 0. That verbosity defaults to pytest's
# own, which is 0 in the commit check's run, so it is raised here. On an
# earlier pytest the pytest-subtests plugin counts a skipped one as skipped and
# an xfailed one as `subtests xfailed`, and ignores the option (diary decision
# 2026-11-22: subtests counted as tests set aside, under pytest 9 and the
# plugin).
run_group() {
    local hooks hook out addopts="${PYTEST_ADDOPTS:-}"
    hooks="$(hooks_of "$1")" || exit 1
    if [[ "$1" == pytest ]]; then
        addopts="${addopts} -o verbosity_subtests=1"
    fi
    ran=""
    while IFS= read -r hook; do
        [[ -n "${hook}" ]] || continue
        if [[ "${hook}" == "left "* ]]; then
            left_out+=("${hook#left }")
            continue
        fi
        hook="${hook#run }"
        out="$(PYTEST_ADDOPTS="${addopts}" \
            prek run -v "${hook}" --all-files 2>&1 | plain)"
        if grep -qE '^[^[:space:]].*\(no files to check\)Skipped[[:space:]]*$' <<<"${out}"; then
            if [[ "${hook}" == ".:$1" ]]; then
                printf 'hh-metrics: prek skipped the pack'\''s hook %s, which no file matched, so there is no coverage figure:\n%s\n' \
                    "${hook}" "${out}" >&2
                exit 1
            fi
            continue
        fi
        ran=1
        "read_$1" "${hook}" "${out}"
    done <<<"${hooks}"
}

# The Python pack's figures. The TOTAL row of pytest-cov's report gives
# statements, missed and the percentage. The tests pytest set aside come from
# its summary line: those it skipped, and those a mark expected to fail, whether
# they failed or passed. /hh-wrap raises each with the operator (diary decision
# 2026-11-24: tests set aside counted by the test runner, each listed by name).
cov_now=""
skip_now=""
skip_pattern='Metrics: pytest set aside [0-9]+ skipped, [0-9]+ xfailed, [0-9]+ xpassed\.'
cov_pattern='Metrics: coverage [0-9]+% of [0-9]+ statements, [0-9]+ missed\.'
skipped=0
xfailed=0
xpassed=0
read_pytest() {
    local hook="$1" out="$2" rows statements missed percent summary
    if [[ "${hook}" == .:pytest ]]; then
        rows="$(grep -E '^[[:space:]]*TOTAL[[:space:]]' <<<"${out}")"
        read -r _ statements missed percent _ <<<"${rows##*$'\n'}"
        if [[ ! "${statements:-}" =~ ^[0-9]+$ || ! "${missed:-}" =~ ^[0-9]+$ || ! "${percent:-}" =~ ^[0-9]+%$ ]]; then
            printf 'hh-metrics: no coverage total in the output of prek run %s:\n%s\n' "${hook}" "${out}" >&2
            exit 1
        fi
        cov_now="Metrics: coverage ${percent} of ${statements} statements, ${missed} missed."
    fi
    summary="$(grep -E '^[[:space:]]*(=+ )?(no tests ran|[0-9]+ [a-z]+( [a-z]+)*(, [0-9]+ [a-z]+( [a-z]+)*)*) in [0-9.]+s' <<<"${out}")"
    if [[ -z "${summary}" ]]; then
        printf 'hh-metrics: no summary line in the output of prek run %s:\n%s\n' "${hook}" "${out}" >&2
        exit 1
    fi
    summary="${summary##*$'\n'}"
    skipped=$((skipped + $(count "${summary}" skipped)))
    xfailed=$((xfailed + $(count "${summary}" xfailed) + $(count "${summary}" 'subtests xfailed')))
    xpassed=$((xpassed + $(count "${summary}" xpassed)))
}
run_group pytest
if [[ -n "${ran}" ]]; then
    skip_now="Metrics: pytest set aside ${skipped} skipped, ${xfailed} xfailed, ${xpassed} xpassed."
fi

# The TypeScript pack's figures. The Statements row of Vitest's text-summary
# report gives the percentage, the statements covered and the total. The tests
# Vitest set aside come from its Tests row: those it skipped, which include those
# a `.only` left out, and those written as todo.
vcov_now=""
vskip_now=""
vskip_pattern='Metrics: Vitest set aside [0-9]+ skipped, [0-9]+ todo\.'
vcov_pattern='Metrics: Vitest coverage [0-9.]+% of [0-9]+ statements, [0-9]+ missed\.'
vskipped=0
vtodo=0
read_vitest() {
    local hook="$1" out="$2" row covered total
    if [[ "${hook}" == .:vitest ]]; then
        row="$(grep -E '^[[:space:]]*Statements[[:space:]]*:' <<<"${out}")"
        if [[ ! "${row##*$'\n'}" =~ :[[:space:]]*([0-9.]+%)[[:space:]]*\([[:space:]]*([0-9]+)/([0-9]+)[[:space:]]*\) ]]; then
            printf 'hh-metrics: no coverage total in the output of prek run %s:\n%s\n' "${hook}" "${out}" >&2
            exit 1
        fi
        covered="${BASH_REMATCH[2]}"
        total="${BASH_REMATCH[3]}"
        vcov_now="Metrics: Vitest coverage ${BASH_REMATCH[1]} of ${total} statements, $((total - covered)) missed."
    fi
    row="$(grep -E '^[[:space:]]*Tests[[:space:]]+[0-9]+ [a-z]+.*\([0-9]+\)[[:space:]]*$' <<<"${out}")"
    if [[ -z "${row}" ]]; then
        printf 'hh-metrics: no Tests row in the output of prek run %s:\n%s\n' "${hook}" "${out}" >&2
        exit 1
    fi
    row="${row##*$'\n'}"
    vskipped=$((vskipped + $(count "${row}" skipped)))
    vtodo=$((vtodo + $(count "${row}" todo)))
}
run_group vitest
if [[ -n "${ran}" ]]; then
    vskip_now="Metrics: Vitest set aside ${vskipped} skipped, ${vtodo} todo."
fi

# In a fork, the copies upstream's code does not have, as hh-clones lists them,
# and the coverage of the lines changed since upstream's code: the fork's tests,
# run by its own `npm test` under c8, which collects Node's coverage from any
# Node command, read by diff-cover against that commit. Whole-file coverage
# would mostly measure upstream's lines (diary decision 2026-11-14: copies in a
# fork counted against upstream's release) (diary decision 2026-11-14: coverage
# in a fork counted on its own changed lines). Both tools are pinned here.
here="$(dirname "$0")"
fork_dup_now=""
fork_dup_pattern="Metrics: the fork's own duplication [0-9]+ sets from [0-9]+ clones\\."
fork_cov_now=""
fork_cov_pattern="Metrics: the fork's changed lines [0-9]+% covered, [0-9]+ of [0-9]+ missed\\."
base="$("${here}/hh-upstream-base")" || exit 1
if [[ -n "${base}" ]]; then
    out="$("${here}/hh-clones" --no-tests 2>&1)" || {
        printf 'hh-metrics: hh-clones failed:\n%s\n' "${out}" >&2
        exit 1
    }
    if [[ ! "${out}" =~ ([0-9]+)\ sets\ from\ ([0-9]+)\ clones ]]; then
        printf 'hh-metrics: no set count in the output of hh-clones:\n%s\n' "${out}" >&2
        exit 1
    fi
    fork_dup_now="Metrics: the fork's own duplication ${BASH_REMATCH[1]} sets from ${BASH_REMATCH[2]} clones."
    if [[ -f package.json ]] && jq -e '.scripts.test' package.json >/dev/null; then
        work="$(mktemp -d "${TMPDIR:-/tmp}/hh-metrics.XXXXXX")" || exit 1
        trap 'rm -rf -- "${work:?}"' EXIT
        if ! out="$(npm_config_cache="${TMPDIR:-/tmp}/hh-rules-npm" npx -y c8@10.1.3 \
            --reporter=lcovonly --report-dir "${work}" --temp-directory "${work}/raw" \
            npm test 2>&1)"; then
            printf 'hh-metrics: the tests failed under c8:\n%s\n' "${out}" >&2
            exit 1
        fi
        if ! out="$(UV_TOOL_DIR="${TMPDIR:-/tmp}/hh-rules-uv" uvx --from diff-cover==9.7.2 \
            diff-cover "${work}/lcov.info" --compare-branch="${base}" 2>&1)"; then
            printf 'hh-metrics: diff-cover failed:\n%s\n' "${out}" >&2
            exit 1
        fi
        total_lines="$(sed -nE 's/^Total: +([0-9]+) lines$/\1/p' <<<"${out}")"
        missing="$(sed -nE 's/^Missing: +([0-9]+) lines$/\1/p' <<<"${out}")"
        covered="$(sed -nE 's/^Coverage: +([0-9]+)%$/\1/p' <<<"${out}")"
        if [[ ! "${total_lines}" =~ ^[0-9]+$ || ! "${missing}" =~ ^[0-9]+$ || ! "${covered}" =~ ^[0-9]+$ ]]; then
            printf 'hh-metrics: no totals in the output of diff-cover:\n%s\n' "${out}" >&2
            exit 1
        fi
        fork_cov_now="Metrics: the fork's changed lines ${covered}% covered, ${missing} of ${total_lines} missed."
    fi
fi

# The diary files sort by date, so the last match of each kind is the newest.
shopt -s nullglob
diary=(diary/*.md)
flat=""
if ((${#diary[@]} > 0)); then
    flat="$(cat "${diary[@]}")"
    flat="$(tr -s '[:space:]' ' ' <<<"${flat}")"
fi

# Prints a metric's line and its change since the last one in the diary.
report() {
    local now="$1" pattern="$2" last
    last="$(grep -oE "${pattern}" <<<"${flat}")"
    last="${last##*$'\n'}"
    echo "${now}"
    if [[ -z "${last}" ]]; then
        echo "Change: no earlier figures in the diary."
    elif [[ "${last}" == "${now}" ]]; then
        echo "Change: none since the last figures in the diary."
    else
        echo "Change: was ${last#Metrics: }"
    fi
}

report "${dup_now}" "${dup_pattern}"
# The exclusions are printed with the figure every time, so none is hidden.
# jscpd-run sits beside this script, in bin/ or .hh/shared/.
excluded="$("${here}/jscpd-run" --exclusions)" || exit 1
echo "Excluded from duplication: ${excluded:-none}"
if [[ -n "${cov_now}" ]]; then
    report "${cov_now}" "${cov_pattern}"
fi
if [[ -n "${skip_now}" ]]; then
    report "${skip_now}" "${skip_pattern}"
fi
if [[ -n "${vcov_now}" ]]; then
    report "${vcov_now}" "${vcov_pattern}"
fi
if [[ -n "${vskip_now}" ]]; then
    report "${vskip_now}" "${vskip_pattern}"
fi
if [[ -n "${fork_dup_now}" ]]; then
    report "${fork_dup_now}" "${fork_dup_pattern}"
fi
if [[ -n "${fork_cov_now}" ]]; then
    report "${fork_cov_now}" "${fork_cov_pattern}"
fi
for hook in "${left_out[@]}"; do
    echo "Not measured: ${hook}, left out of the commit checks."
done
