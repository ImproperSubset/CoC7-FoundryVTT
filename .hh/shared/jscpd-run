#!/usr/bin/env bash
# Runs jscpd with the project's .jscpd.jsonc, whose comments give the reason
# for each exclusion. jscpd reads only strict JSON, and silently falls back to
# its defaults on a config it cannot parse, so this strips whole-line //
# comments and the trailing commas Prettier writes in .jsonc, checks that what
# is left parses, and hands it to jscpd, or with --exclusions prints them. The exclusions are never dropped
# silently: a missing or unreadable config stops the run.
set -uo pipefail

config=".jscpd.jsonc"
if [[ ! -f "${config}" ]]; then
    echo "jscpd-run: no ${config} in ${PWD}" >&2
    exit 2
fi
json="$(perl -0pe 's{^[ \t]*//[^\n]*\n}{}mg; s{,(\s*[\]\}])}{$1}g' "${config}")" || exit 2
if ! jq empty <<<"${json}" 2>/dev/null; then
    echo "jscpd-run: ${config} is not JSON once its comments are stripped" >&2
    exit 2
fi
# --exclusions prints the exclusions, one line, for hh-metrics' report.
if [[ "${1:-}" == "--exclusions" ]]; then
    jq -r '(.ignore // []) | join(", ")' <<<"${json}"
    exit
fi
# --new-since <ref> marks the clones that <ref> does not have, and
# --new-since-head does so for HEAD, for the commit check; a repository with
# no commit yet runs without the comparison, and every clone in it is new.
# jscpd's own --baseline-from-ref checks the ref out with `git worktree add`,
# which fails in Claude Code's sandbox, where .git/worktrees is read-only; so
# the ref's tree is exported with `git archive` into a temporary folder,
# scanned there with the same config and arguments to write a baseline, and
# the working tree is then compared with that baseline.
since=""
if [[ "${1:-}" == "--new-since-head" ]]; then
    shift
    if git rev-parse --verify --quiet HEAD >/dev/null; then
        since="HEAD"
    fi
elif [[ "${1:-}" == "--new-since" ]]; then
    if [[ $# -lt 2 ]]; then
        echo "jscpd-run: --new-since needs a ref" >&2
        exit 2
    fi
    since="$2"
    shift 2
fi
work="$(mktemp -d "${TMPDIR:-/tmp}/jscpd-run.XXXXXX")" || exit 2
trap 'rm -rf -- "${work:?}"' EXIT
printf '%s\n' "${json}" >"${work}/config.json"
if [[ -n "${since}" ]]; then
    mkdir "${work}/tree"
    if ! git archive --format=tar "${since}" | tar -x -C "${work}/tree"; then
        echo "jscpd-run: cannot export ${since}'s tree" >&2
        exit 2
    fi
    if ! (cd "${work}/tree" && jscpd --config "${work}/config.json" \
        --baseline "${work}/baseline.json" --update-baseline "$@" >"${work}/base.log" 2>&1); then
        echo "jscpd-run: the scan of ${since} failed:" >&2
        cat "${work}/base.log" >&2
        exit 2
    fi
    set -- --baseline "${work}/baseline.json" "$@"
fi
jscpd --config "${work}/config.json" "$@"
