// Copied to a project's root by /hh-rules. jscpd's exclusions, each with its
// reason beside it, and each agreed with the operator. bin/jscpd-run strips the
// comments before jscpd reads the file.
{
  "ignore": [
    // git's own directory, which holds sample hook scripts.
    "**/.git/**",
    // The diary: append-only, and its entries restate earlier decisions by
    // design, so a repeat there has no fix.
    "diary/**",
    // hh-rules' files, copied in by /hh-rules: they are measured in hh-rules,
    // the repository they call home, and are not the project's own code.
    ".hh/shared/**",
    // The Foundry modules pack's release workflow, copied in by /hh-rules for
    // the same reason.
    ".github/workflows/hh-foundry-modules-release.yml",
    // hh-rules' skills, pinned at the project's tag and generated by rulesync:
    // measured in hh-rules for the same reason.
    ".claude/skills/hh-*/**",
    // jscpd's own skills, pinned with the jscpd version hh-rules pins: they
    // are jscpd's files, not the project's.
    ".claude/skills/dry-refactoring/**",
    ".claude/skills/jscpd/**",
    // Lock files, which npm and uv generate and rewrite on every install, so a
    // repeat there has no fix.
    "**/package-lock.json",
    "**/uv.lock",
  ],
}
